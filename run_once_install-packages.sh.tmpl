{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash

type -p curl >/dev/null || (sudo apt update && sudo apt install curl -y)
curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
&& sudo chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
&& echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null

sudo apt update 
sudo apt install ripgrep tmux fzf gh jq build-essential zsh -y
sudo snap install nvim --classic

# Install tree-sitter-cli
curl -LO https://github.com/tree-sitter/tree-sitter/releases/download/v0.26.8/tree-sitter-cli-linux-x64.zip
unzip tree-sitter-cli-linux-x64.zip
sudo mv -vn tree-sitter /usr/local/bin/tree-sitter
sudo chmod +x /usr/local/bin/tree-sitter
rm tree-sitter-cli-linux-x64.zip


## Install Oh My Zsh!
sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"

## Install Oh my tmux!
cd
git clone https://github.com/gpakosz/.tmux
ln -s -f .tmux/.tmux.conf

## Install NVM
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.4/install.sh | bash

source ~/.nvm/nvm.sh
source ~/.profile
source ~/.bashrc

nvm install lts/hydrogen # node 18
nvm install lts/iron # node 20
nvm alias default lts/iron

## Set Zsh as default shell

chsh -s $(which zsh)
{{ end -}}
